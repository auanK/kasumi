# Maintainer: auanK <https://github.com/auanK/kasumi>
pkgname=kasumi
pkgver=0.29.2
pkgrel=1
pkgdesc="Multi-device encrypted bidirectional file synchronization without a dedicated server"
arch=('x86_64')
url="https://github.com/auanK/kasumi"
license=('MIT')
install=kasumi.install
depends=('glibc' 'gcc-libs')
optdepends=(
  'rclone: remote cloud storage backends'
  'libsecret: GNOME Keyring / Secret Service vault storage'
  'kwallet: KDE KWallet vault storage'
)
makedepends=('cmake' 'ninja' 'python' 'gcc' 'nodejs' 'npm')
source=("kasumi-${pkgver}.tar.gz::https://github.com/auanK/kasumi/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}/web"
  npm ci
  npm run build
  cd "${srcdir}/${pkgname}-${pkgver}"
  cmake --preset default -DBUILD_TESTING=OFF
  cmake --build --preset default --parallel
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 "build/kasumi" "${pkgdir}/usr/bin/kasumi"
  install -Dm644 "packaging/linux/kasumi.desktop" "${pkgdir}/usr/share/applications/kasumi.desktop"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "THIRD_PARTY_NOTICES.md" "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
}
