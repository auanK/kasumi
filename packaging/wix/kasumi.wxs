<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Kasumi"
           Manufacturer="auanK"
           Version="$(var.ProductVersion)"
           UpgradeCode="B9E7C4A2-8D13-4F6E-9A51-2C6D8E4F1B70"
           Scope="perMachine"
           InstallerVersion="500">
    <SummaryInformation Description="Multi-client encrypted bidirectional file synchronization without a dedicated server" />
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/auanK/kasumi" />

    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="FindPreviousInstallFolder"
                      Root="HKLM"
                      Key="Software\auanK\Kasumi"
                      Name="InstallFolder"
                      Type="raw" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Kasumi">
        <Component Id="KasumiExecutable">
          <File Id="KasumiExe" Source="$(var.BinPath)" KeyPath="yes" />
          <RegistryValue Root="HKLM"
                         Key="Software\auanK\Kasumi"
                         Name="InstallFolder"
                         Type="string"
                         Value="[INSTALLFOLDER]" />
          <Environment Id="KasumiSystemPath"
                       Name="PATH"
                       Value="[INSTALLFOLDER]"
                       Permanent="no"
                       Part="last"
                       Action="set"
                       System="yes" />
        </Component>

        <Component Id="KasumiLicenseFile">
          <File Id="KasumiLicense" Source="$(var.LicensePath)" KeyPath="yes" />
        </Component>

        <Component Id="KasumiNoticesFile">
          <File Id="KasumiNotices" Source="$(var.NoticesPath)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Kasumi" Level="1">
      <ComponentRef Id="KasumiExecutable" />
      <ComponentRef Id="KasumiLicenseFile" />
      <ComponentRef Id="KasumiNoticesFile" />
    </Feature>

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
