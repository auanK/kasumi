if(NOT EXISTS "${KASUMI_EXECUTABLE}" OR NOT EXISTS "${CRASH_HELPER}")
    message(FATAL_ERROR "CLI and crash helper binaries are required")
endif()
string(HEX "KASUMI_CRASH_TEST_POINT" signature)
file(READ "${KASUMI_EXECUTABLE}" executable HEX)
string(FIND "${executable}" "${signature}" found)
if(NOT found EQUAL -1)
    message(FATAL_ERROR "Normal kasumi binary exposes the crash-test environment hook")
endif()
file(READ "${CRASH_HELPER}" helper HEX)
string(FIND "${helper}" "${signature}" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Crash helper is missing its test-only hook")
endif()
